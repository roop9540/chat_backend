{
  "name": "chat-backend",
  "version": "1.0.0",
  "description": "1:1 and group chat backend: PostgreSQL for users/chats, Firebase Firestore for messages and read receipts",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "emulator": "firebase emulators:start --only firestore --project demo-chat-backend",
    "test": "vitest run",
    "test:ci": "firebase emulators:exec --only firestore --project demo-chat-backend \"npm test\""
  },
  "license": "MIT",
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  }
}
